# Copy to .env on the server and fill in every value marked CHANGE ME.
#
#   cp .env.example .env && chmod 600 .env
#
# .env is git-ignored and must never be committed. Generation commands for
# each secret are in the README value table.
#
# Keep generated passwords alphanumeric: several of them are interpolated
# into connection URLs, where /, @, : and # would need percent-encoding.
#
# Never put a trailing comment on a line whose value is empty. Compose only
# strips an inline comment when something precedes it, so `FOO=   # CHANGE
# ME` sets FOO to the literal text "# CHANGE ME" — which is not empty, so
# `${FOO:?...}` does not fire and the placeholder silently becomes a
# hostname or a password. Comments for empty values go on their own line.


# --- compose wiring ----------------------------------------------------
# Merges the per-app override files on top of docker-compose.yml so a plain
# `docker compose up -d` starts the whole platform. Order matters.
COMPOSE_FILE=docker-compose.yml:edge/compose.override.yml:proxy/compose.override.yml:postgres/compose.override.yml:redis/compose.override.yml:zot/compose.override.yml:infisical/compose.override.yml
COMPOSE_PROJECT_NAME=platform

# The socket nginx-proxy and acme-companion query for container events. It
# MUST be the socket your docker CLI actually talks to — under rootless
# docker that is not /var/run/docker.sock, and mounting the rootful one
# instead fails with a permission error that surfaces as the misleading
# "can't get docker-gen container id". `make doctor` prints the right value.
#DOCKER_HOST_PATH=/run/user/1000/docker.sock


# --- image versions ----------------------------------------------------
# Pin these in production; the compose defaults are floating tags.
POSTGRES_VERSION=17-alpine
REDIS_VERSION=7-alpine
ZOT_VERSION=latest
INFISICAL_VERSION=latest
# Note: acme-companion's "latest" is a rolling dev build (it reports itself
# as e.g. v2.8.2-12-g6b369e6). Track the release series instead.
NGINX_PROXY_VERSION=1.11-alpine
ACME_COMPANION_VERSION=2.8
# Plain upstream nginx, used only by the L4 edge. Pin the minor series once
# the stack is up, e.g. 1.31-alpine.
NGINX_VERSION=alpine


# --- public hostnames and TLS ------------------------------------------
# Both names must already resolve (A/AAAA) to this VM before the first
# start: Let's Encrypt validates over HTTP-01 on port 80.
#
# These two are also the exception list the edge routes by: a TLS
# connection whose SNI is one of them is handed to nginx-proxy, anything
# else goes to Kubernetes. A platform vhost missing from here would be
# routed into the cluster instead.
# CHANGE ME — e.g. registry.example.com
REGISTRY_HOST=
# CHANGE ME — e.g. secrets.example.com
SECRETS_HOST=


# Where expiry notices go.
# CHANGE ME — you@example.com
ACME_EMAIL=

# Let's Encrypt rate-limits failures hard (5/hour, 50 certs/week per
# domain). Uncomment the staging directory while testing DNS and firewall,
# then comment it out and `docker compose up -d --force-recreate acme` to
# get real certificates.
#ACME_CA_URI=https://acme-staging-v02.api.letsencrypt.org/directory


# --- kubernetes ingress ------------------------------------------------
# Where the cluster's ingress NodePorts (30080 plain / 30443 TLS) can be
# reached FROM INSIDE a container. 127.0.0.1 is the container's own
# loopback, not the host's, so it never works — it is only the default so
# that the platform still starts before k3s exists (cluster hostnames get a
# 502 until then).
#
# Under rootless Docker the container cannot reach the host's loopback at
# all; the VM's own routable address is the reliable answer:
#
#     ip -4 addr show scope global | awk '/inet /{print $2}'
#     make cluster-check          # probes the candidates from the edge
#
# Firewall 30080/30443 from the internet: on a routable address they are
# otherwise a second, unrouted front door into the cluster.
# e.g. 10.0.0.5 — leave empty until k3s is up
CLUSTER_INGRESS_IP=


# --- postgres ----------------------------------------------------------
# Superuser. Used for administration and backups only — every app gets its
# own role and database (see postgres/init/01-init-databases.sh).
POSTGRES_USER=postgres
# CHANGE ME — openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_PORT=5432            # published on 127.0.0.1 only


# --- redis -------------------------------------------------------------
# CHANGE ME — openssl rand -hex 24
REDIS_PASSWORD=


# --- zot registry ------------------------------------------------------
ZOT_PORT=5000                 # published on 127.0.0.1 only
# Registry credentials are NOT set here — zot reads zot/config/htpasswd:
#   docker run --rm httpd:alpine htpasswd -nbB admin '<password>' \
#     >> zot/config/htpasswd
# Creating the entry grants nothing on its own: accessControl in
# config.json denies anyone it does not name. "admin" is full access,
# "ci" pushes to apps/** and charts/**, "k8s" reads. See the README.


# --- infisical ---------------------------------------------------------
INFISICAL_PORT=8080           # published on 127.0.0.1 only

# Password for the "infisical" postgres role. Only read on the FIRST postgres
# start; changing it later means an ALTER ROLE by hand as well.
# CHANGE ME — openssl rand -hex 24
INFISICAL_DB_PASSWORD=
KOVOSPACE_DB_PASSWORD=

# Root key for the secrets Infisical stores. Losing or changing it makes
# every stored secret permanently unreadable. Back it up outside this VM.
# CHANGE ME — openssl rand -hex 16
INFISICAL_ENCRYPTION_KEY=

# Signs session/JWT tokens. Rotating it logs everybody out.
# CHANGE ME — openssl rand -base64 32
INFISICAL_AUTH_SECRET=

# Public URL Infisical builds links with. Must match SECRETS_HOST exactly,
# including the scheme, or invite and password-reset links break.
# CHANGE ME — https://secrets.example.com
INFISICAL_SITE_URL=


# --- infisical smtp (optional) -----------------------------------------
# Without these, invites, password resets and alerts are not delivered. The
# first admin account can still be created without SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=Kovostack Platform