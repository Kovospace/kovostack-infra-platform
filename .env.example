# Copy to .env on the server and fill in every value marked CHANGE ME.
#
#   cp .env.example .env && chmod 600 .env
#
# .env is git-ignored and must never be committed. Generation commands for
# each secret are in the README value table.
#
# Keep generated passwords alphanumeric: several of them are interpolated
# into connection URLs, where /, @, : and # would need percent-encoding.


# --- compose wiring ----------------------------------------------------
# Merges the per-app override files on top of docker-compose.yml so a plain
# `docker compose up -d` starts the whole platform. Order matters.
COMPOSE_FILE=docker-compose.yml:proxy/compose.override.yml:postgres/compose.override.yml:redis/compose.override.yml:zot/compose.override.yml:infisical/compose.override.yml
COMPOSE_PROJECT_NAME=platform

# Only if the docker socket is not in the default place (rootless docker).
#DOCKER_HOST_PATH=/run/user/1000/docker.sock


# --- image versions ----------------------------------------------------
# Pin these in production; the compose defaults are floating tags.
POSTGRES_VERSION=17-alpine
REDIS_VERSION=7-alpine
ZOT_VERSION=latest
INFISICAL_VERSION=latest
# Note: acme-companion's "latest" is a rolling dev build (it reports itself
# as e.g. v2.8.2-12-g6b369e6). Track the release series instead.
NGINX_PROXY_VERSION=1.11-alpine
ACME_COMPANION_VERSION=2.8


# --- public hostnames and TLS ------------------------------------------
# Both names must already resolve (A/AAAA) to this VM before the first
# start: Let's Encrypt validates over HTTP-01 on port 80.
REGISTRY_HOST=            # CHANGE ME — e.g. registry.example.com
SECRETS_HOST=             # CHANGE ME — e.g. secrets.example.com

# Where expiry notices go.
ACME_EMAIL=               # CHANGE ME — you@example.com

# Let's Encrypt rate-limits failures hard (5/hour, 50 certs/week per
# domain). Uncomment the staging directory while testing DNS and firewall,
# then comment it out and `docker compose up -d --force-recreate acme` to
# get real certificates.
#ACME_CA_URI=https://acme-staging-v02.api.letsencrypt.org/directory


# --- postgres ----------------------------------------------------------
# Superuser. Used for administration and backups only — every app gets its
# own role and database (see postgres/init/01-init-databases.sh).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=            # CHANGE ME — openssl rand -hex 24
POSTGRES_PORT=5432            # published on 127.0.0.1 only


# --- redis -------------------------------------------------------------
REDIS_PASSWORD=               # CHANGE ME — openssl rand -hex 24


# --- zot registry ------------------------------------------------------
ZOT_PORT=5000                 # published on 127.0.0.1 only
# Registry credentials are NOT set here — zot reads zot/config/htpasswd:
#   docker run --rm httpd:alpine htpasswd -nbB admin '<password>' \
#     >> zot/config/htpasswd
# The user named "admin" gets push rights via adminPolicy in config.json;
# every other user is read-only.


# --- infisical ---------------------------------------------------------
INFISICAL_PORT=8080           # published on 127.0.0.1 only

# Password for the "infisical" postgres role. Only read on the FIRST postgres
# start; changing it later means an ALTER ROLE by hand as well.
INFISICAL_DB_PASSWORD=        # CHANGE ME — openssl rand -hex 24

# Root key for the secrets Infisical stores. Losing or changing it makes
# every stored secret permanently unreadable. Back it up outside this VM.
INFISICAL_ENCRYPTION_KEY=     # CHANGE ME — openssl rand -hex 16

# Signs session/JWT tokens. Rotating it logs everybody out.
INFISICAL_AUTH_SECRET=        # CHANGE ME — openssl rand -base64 32

# Public URL Infisical builds links with. Must match SECRETS_HOST exactly,
# including the scheme, or invite and password-reset links break.
INFISICAL_SITE_URL=        # CHANGE ME — https://secrets.example.com


# --- infisical smtp (optional) -----------------------------------------
# Without these, invites, password resets and alerts are not delivered. The
# first admin account can still be created without SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=Kovostack Platform